server {
    listen 80;
    server_name ${DOMAIN};

    client_max_body_size 10M;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # ACME challenge for certbot (optional, safe to leave)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Main API — Orchestrator
    location / {
        proxy_pass http://orchestrator:8002;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    # Auth Service
    location /api/auth/ {
        proxy_pass http://auth_service:8004;
    }

    # User Service
    location /api/users/ {
        proxy_pass http://user_service:8005;
    }

    # Health check endpoint (no auth)
    location /health {
        proxy_pass http://orchestrator:8002/health;
    }
}
