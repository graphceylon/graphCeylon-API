server {
    listen 80;
    server_name ${DOMAIN};

    client_max_body_size 10M;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # ACME challenge for certbot (optional, safe to leave)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # ==========================================
    # Auth & User Services (Node.js)
    # They inherently listen on /api/auth & /api/users
    # ==========================================
    location /api/auth/ {
        proxy_pass http://auth_service:8004;
    }

    location /api/users/ {
        proxy_pass http://user_service:8005;
    }

    # ==========================================
    # Data & AI Services (Python)
    # Using trailing slashes to strip the prefix
    # ==========================================
    
    # Language Service
    location /api/language/ {
        proxy_pass http://language_service:8001/;
    }

    # KG Service
    location /api/kg/ {
        proxy_pass http://kg_service:8000/;
    }

    # Recommender Service
    location /api/recommender/ {
        proxy_pass http://recommender_service:8003/;
    }

    # ==========================================
    # Main API — Orchestrator
    # Root paths explicitly fallback to Orchestrator
    # ==========================================
    
    location /api/orchestrator/ {
        proxy_pass http://orchestrator:8002/;
    }

    location / {
        proxy_pass http://orchestrator:8002;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }
}
