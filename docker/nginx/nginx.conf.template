# Automatically redirect all HTTP traffic to HTTPS
server {
    listen 80;
    server_name ${DOMAIN};

    # Allow certbot to renew certificates automatically via port 80
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect everything else to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# Secure HTTPS Server
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    # Use Docker's internal DNS so upstreams are re-resolved after container restarts
    resolver 127.0.0.11 valid=30s ipv6=off;

    # Load the certificates you just generated
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    
    # Modern secure connection settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 10M;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # Increase proxy timeout for heavy initialization jobs
    proxy_read_timeout 300s;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;

    # ==========================================
    # Auth & User Services (Node.js)
    # ==========================================
    location /api/auth/ {
        set $upstream_auth http://auth_service:8004;
        proxy_pass $upstream_auth;
    }

    location /api/users/ {
        set $upstream_users http://user_service:8005;
        proxy_pass $upstream_users;
    }

    # ==========================================
    # Data & AI Services (Python)
    # ==========================================
    location /api/language/ {
        set $upstream_language http://language_service:8001;
        proxy_pass $upstream_language/;
    }

    location /api/kg/ {
        set $upstream_kg http://kg_service:8000;
        proxy_pass $upstream_kg/;
    }

    location /api/recommender/ {
        set $upstream_recommender http://recommender_service:8003;
        proxy_pass $upstream_recommender/;
    }

    # ==========================================
    # Main API — Orchestrator
    # ==========================================
    location /api/orchestrator/ {
        set $upstream_orchestrator http://orchestrator:8002;
        proxy_pass $upstream_orchestrator/;
    }

    location / {
        set $upstream_orchestrator http://orchestrator:8002;
        proxy_pass $upstream_orchestrator;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }
}
