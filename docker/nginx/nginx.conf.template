server {
    listen 80;
    server_name ${DOMAIN};


    server {
        listen 80;
        server_name ${DOMAIN};

        # ACME challenge for certbot (optional, safe to leave)
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Main API — Orchestrator
        location / {
            proxy_pass http://orchestrator:8002;
            proxy_read_timeout 120s;
            proxy_connect_timeout 10s;
        }

        # Auth Service
        location /api/auth/ {
            proxy_pass http://auth_service:8004;
        }

        # User Service
        location /api/users/ {
            proxy_pass http://user_service:8005;
        }

        # Health check endpoint (no auth)
        location /health {
            proxy_pass http://orchestrator:8002/health;
        }
    }

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    # Request size limit (for file uploads if needed)
    client_max_body_size 10M;
}
