    },
    "item": [
        {
            "name": "Search Attractions in Kandy",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"city\": \"Kandy\",\n  \"country\": \"Sri Lanka\",\n  \"query\": \"What are the main tourist attractions in Kandy?\"\n}"
                },
                "url": {
                    "raw": "http://localhost:8003/attractions/orchestrator/call/attractions",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8003",
                    "path": [
                        "attractions",
                        "orchestrator",
                        "call",
                        "attractions"
                    ]
                },
                "description": "Search for all attractions in Kandy"
            }
        },
