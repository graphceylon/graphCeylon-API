# ============================================================
# GraphCeylon API — Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in all values.
# NEVER commit .env.production to version control.
# ============================================================

# ---- GCP ----
GCP_PROJECT_ID=
GCP_REGION=us-central1
ARTIFACT_REGISTRY_REPO=graphceylon

# ---- Image Tags (set by CI/CD, override for manual deploy) ----
IMAGE_TAG=latest

# ---- PostgreSQL ----
POSTGRES_USER=graphceylon
POSTGRES_PASSWORD=
POSTGRES_DB=graphceylon_users

# ---- Neo4j ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=

# ---- Auth Service ----
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# ---- Service-to-Service Auth ----
SERVICE_TOKEN=

# ---- API Keys ----
OPENAI_API_KEY=
GROQ_API_KEY=
OPENWEATHER_API_KEY=

# ---- SSL / Domain ----
DOMAIN=yourdomain.com
SSL_EMAIL=admin@yourdomain.com
