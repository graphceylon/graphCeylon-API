                            ],
                            "path": [
                                "railway",
                                "schedules"
                            ],
                            "query": [
                                {
                                    "key": "schedule_date",
                                    "value": "{{schedule_date}}"
                                },
                                {
                                    "key": "train_type",
                                    "value": "Express"
                                },
                                {
                                    "key": "limit",
                                    "value": "20"
