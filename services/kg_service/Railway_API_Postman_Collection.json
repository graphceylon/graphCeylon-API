{
    "info": {
        "_postman_id": "railway-api-collection",
        "name": "GraphCeylon - Railway & Train Schedules API",
        "description": "Complete API collection for Railway Stations and Train Schedules in Sri Lanka Tourism Knowledge Graph.\n\nThis collection covers:\n- Railway Station endpoints (CRUD, search, statistics)\n- Train Schedule endpoints (CRUD, search, route finding)\n- Initialization and data loading\n- Statistics and analytics\n\n**Base URL**: http://localhost:8000\n\n**Domain**: Transportation (Domain 4 in the Knowledge Graph)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Railway Stations",
            "item": [
                {
                    "name": "Get All Railway Stations",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/stations?limit=50",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations"
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "50",
                                    "description": "Maximum number of results"
                                },
                                {
                                    "key": "province",
                                    "value": "Western Province",
                                    "disabled": true,
                                    "description": "Filter by province"
                                },
                                {
                                    "key": "district",
                                    "value": "Colombo",
                                    "disabled": true,
                                    "description": "Filter by district"
                                },
                                {
                                    "key": "name_pattern",
                                    "value": "Fort",
                                    "disabled": true,
                                    "description": "Search by station name"
                                },
                                {
                                    "key": "is_major",
                                    "value": "true",
                                    "disabled": true,
                                    "description": "Filter major stations only"
                                }
                            ]
                        },
                        "description": "Get all railway stations with optional filters for province, district, name pattern, and major station status."
                    },
                    "response": []
                },
                {
                    "name": "Get Station by Name",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/stations/by-name/Colombo Fort",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations",
                                "by-name",
                                "Colombo Fort"
                            ]
                        },
                        "description": "Get detailed information about a specific railway station by its name."
                    },
                    "response": []
                },
                {
                    "name": "Get Stations by Province",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/stations/by-province/Western Province",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations",
                                "by-province",
                                "Western Province"
                            ]
                        },
                        "description": "Get all railway stations in a specific province."
                    },
                    "response": []
                },
                {
                    "name": "Get Stations by District",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/stations/by-district/Colombo",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations",
                                "by-district",
                                "Colombo"
                            ]
                        },
                        "description": "Get all railway stations in a specific district."
                    },
                    "response": []
                },
                {
                    "name": "Get Station Statistics",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/stations/statistics",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations",
                                "statistics"
                            ]
                        },
                        "description": "Get comprehensive statistics about railway stations including total count, breakdown by province/district, enrichment status, and major station count."
                    },
                    "response": []
                },
                {
                    "name": "Create Railway Station",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Test Station\",\n  \"geolocation\": {\n    \"coordinates\": {\n      \"latitude\": 6.9271,\n      \"longitude\": 79.8612,\n      \"accuracy\": \"high\"\n    },\n    \"address_info\": {\n      \"administrative_areas\": {\n        \"province\": \"Western Province\",\n        \"district\": \"Colombo\",\n        \"city\": \"Colombo\"\n      }\n    }\n  },\n  \"facilities\": [\"Ticket Office\", \"Waiting Room\", \"Restrooms\"],\n  \"platform_count\": 3,\n  \"is_major_station\": false\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/railway/stations/create",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations",
                                "create"
                            ]
                        },
                        "description": "Create a new railway station in the knowledge graph."
                    },
                    "response": []
                },
                {
                    "name": "Initialize Railway Stations",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/stations/initialize",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations",
                                "initialize"
                            ]
                        },
                        "description": "Bulk load all 203 enriched railway stations from the JSON file into the knowledge graph. This should be run before loading train schedules."
                    },
                    "response": []
                },
                {
                    "name": "Cleanup Railway Data",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/stations/cleanup",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations",
                                "cleanup"
                            ]
                        },
                        "description": "Delete all railway stations and train schedules from the knowledge graph. Use with caution!"
                    },
                    "response": []
                }
            ],
            "description": "Endpoints for managing and querying railway stations in Sri Lanka."
        },
        {
            "name": "Train Schedules",
            "item": [
                {
                    "name": "Get All Train Schedules",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/schedules?schedule_date={{schedule_date}}&limit=100",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules"
                            ],
                            "query": [
                                {
                                    "key": "schedule_date",
                                    "value": "{{schedule_date}}",
                                    "description": "REQUIRED: Schedule date (YYYY-MM-DD)"
                                },
                                {
                                    "key": "limit",
                                    "value": "100",
                                    "description": "Maximum number of results"
                                },
                                {
                                    "key": "start_station",
                                    "value": "Colombo Fort",
                                    "disabled": true,
                                    "description": "Filter by departure station (optional)"
                                },
                                {
                                    "key": "end_station",
                                    "value": "Kandy",
                                    "disabled": true,
                                    "description": "Filter by arrival station (optional)"
                                },
                                {
                                    "key": "train_type",
                                    "value": "Express",
                                    "disabled": true,
                                    "description": "Filter by train type (Express, Semi Express, Slow, Intercity) (optional)"
                                }
                            ]
                        },
                        "description": "Get train schedules. schedule_date is REQUIRED. Optional filters: departure/arrival stations, train type."
                    },
                    "response": []
                },
                {
                    "name": "Get Schedules Colombo to Galle",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/schedules?schedule_date={{schedule_date}}&start_station=Colombo Fort&end_station=Galle",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules"
                            ],
                            "query": [
                                {
                                    "key": "schedule_date",
                                    "value": "{{schedule_date}}",
                                    "description": "REQUIRED: Schedule date"
                                },
                                {
                                    "key": "start_station",
                                    "value": "Colombo Fort"
                                },
                                {
                                    "key": "end_station",
                                    "value": "Galle"
                                }
                            ]
                        },
                        "description": "Example: Get all train schedules from Colombo Fort to Galle on a specific date."
                    },
                    "response": []
                },
                {
                    "name": "Get Schedules by Train Number",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/schedules/by-train/8050?schedule_date={{schedule_date}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules",
                                "by-train",
                                "8050"
                            ],
                            "query": [
                                {
                                    "key": "schedule_date",
                                    "value": "{{schedule_date}}",
                                    "description": "REQUIRED: Schedule date"
                                }
                            ]
                        },
                        "description": "Get all schedules for a specific train number."
                    },
                    "response": []
                },
                {
                    "name": "Find Routes Between Stations",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"start_station\": \"Colombo Fort\",\n  \"end_station\": \"Kandy\",\n  \"max_transfers\": 2,\n  \"preferred_train_type\": \"Express\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/railway/schedules/find-routes",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules",
                                "find-routes"
                            ]
                        },
                        "description": "Find possible routes between two stations, including routes with transfers. Returns direct routes and multi-leg routes with timing and pricing information."
                    },
                    "response": []
                },
                {
                    "name": "Get Station Connections",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/schedules/connections/Colombo Fort",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules",
                                "connections",
                                "Colombo Fort"
                            ]
                        },
                        "description": "Get all stations directly connected to a given station with incoming and outgoing train routes."
                    },
                    "response": []
                },
                {
                    "name": "Get Schedule Statistics",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/schedules/statistics",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules",
                                "statistics"
                            ]
                        },
                        "description": "Get comprehensive statistics about train schedules including total count, unique trains, unique routes, breakdown by train type, and date range coverage."
                    },
                    "response": []
                },
                {
                    "name": "Create Train Schedule",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"schedule_date\": \"2026-01-15\",\n  \"start_station\": \"Colombo Fort\",\n  \"end_station\": \"Kandy\",\n  \"departure_time\": \"08:00 AM\",\n  \"arrival_time\": \"10:45 AM\",\n  \"duration\": \"2h 45m\",\n  \"train_number\": \"1007\",\n  \"train_type\": \"Express\",\n  \"distance\": \"120.5 km\",\n  \"price_2nd_class\": \"Rs. 300.00\",\n  \"price_3rd_class\": \"Rs. 150.00\",\n  \"train_stops\": \"Colombo Fort, Ragama, Gampaha, Polgahawela, Rambukkana, Peradeniya, Kandy\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/railway/schedules/create",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules",
                                "create"
                            ]
                        },
                        "description": "Create a new train schedule in the knowledge graph. Both start and end stations must exist."
                    },
                    "response": []
                },
                {
                    "name": "Initialize Train Schedules",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/schedules/initialize",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules",
                                "initialize"
                            ]
                        },
                        "description": "Bulk load all train schedules from the CSV file into the knowledge graph. Railway stations must be initialized first!"
                    },
                    "response": []
                }
            ],
            "description": "Endpoints for managing and querying train schedules in Sri Lanka."
        },
