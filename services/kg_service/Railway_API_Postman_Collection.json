        {
            "name": "Setup & Initialization",
            "item": [
                {
                    "name": "1. Initialize Stations First",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/stations/initialize",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations",
                                "initialize"
                            ]
                        },
                        "description": "STEP 1: Load all 203 railway stations into the knowledge graph. Must be done before loading schedules."
                    },
                    "response": []
                },
                {
                    "name": "2. Verify Stations Loaded",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/stations/statistics",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "stations",
                                "statistics"
                            ]
                        },
                        "description": "STEP 2: Verify that stations were loaded successfully. Should show 203 total stations."
                    },
                    "response": []
                },
                {
                    "name": "3. Initialize Schedules",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/schedules/initialize",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules",
                                "initialize"
                            ]
                        },
                        "description": "STEP 3: Load all train schedules into the knowledge graph. Stations must be loaded first!"
                    },
                    "response": []
                },
                {
                    "name": "4. Verify Schedules Loaded",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/railway/schedules/statistics",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "railway",
                                "schedules",
                                "statistics"
                            ]
                        },
                        "description": "STEP 4: Verify that schedules were loaded successfully."
                    },
                    "response": []
