            "name": "1. Hotels in Galle",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"intent\": \"info_accommodation\",\n  \"raw_text\": \"Hotels in Galle\",\n  \"user_id\": \"test-user-001\",\n  \"session_id\": \"postman-test-1\",\n  \"city\": \"Galle\",\n  \"limit\": 10\n}"
                },
                "url": {
                    "raw": "{{base_url}}/hotels/orchestrator/call/hotels/search",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "hotels",
                        "orchestrator",
                        "call",
                        "hotels",
                        "search"
                    ]
                },
                "description": "Search for hotels in Galle (should return ~15 hotels)"
            }
        },
