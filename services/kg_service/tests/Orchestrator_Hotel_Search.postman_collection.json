{
    "info": {
        "name": "KG Service - Orchestrator Hotel Search",
        "description": "Test collection for orchestrator hotel search endpoint",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000",
            "type": "string"
        }
