# KG Service Configuration

# Neo4j Database Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# LLM API Keys
KG_OPENAI_API_KEY=your_openai_api_key_here
KG_GROQ_API_KEY=your_groq_api_key_here

# LLM Provider Configuration
# Provider for data ingestion (entity extraction): openai or groq
KG_INGESTION_LLM_PROVIDER=openai
KG_INGESTION_LLM_MODEL=gpt-4o-mini

# Provider for querying (RAG chatbot): openai or groq
KG_QUERY_LLM_PROVIDER=groq
KG_QUERY_LLM_MODEL=llama-3.3-70b-versatile

# LLM Temperature (0 = deterministic, 1 = creative)
KG_LLM_TEMPERATURE=0

# Vector Index Settings
VECTOR_INDEX_NAME=attraction_embeddings
VECTOR_DIMENSIONS=1536

# File Paths (relative to project root)
ONTOLOGY_FILE=neo4j/import/ontology.ttl
SHAPES_FILE=neo4j/import/shapes.ttl
SEED_FILE=neo4j/import/seed.cypher

# Environment variables for Knowledge Graph Service
SERVICE_NAME=kg_service
SERVICE_PORT=8000
LOG_LEVEL=INFO

# Model Configuration
MODEL_PATH=../../../models/kg_service/
USE_GPU=false