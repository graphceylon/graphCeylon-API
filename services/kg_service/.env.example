# KG Service Configuration

# Neo4j Database Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# OpenAI API Key (for embeddings and reasoning)
KG_OPENAI_API_KEY=your_openai_api_key_here

# Vector Index Settings
VECTOR_INDEX_NAME=attraction_embeddings
VECTOR_DIMENSIONS=1536

# File Paths (relative to project root)
ONTOLOGY_FILE=neo4j/import/ontology.ttl
SHAPES_FILE=neo4j/import/shapes.ttl
SEED_FILE=neo4j/import/seed.cypher
