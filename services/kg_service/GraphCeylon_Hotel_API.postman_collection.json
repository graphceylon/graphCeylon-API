                            ],
                            "path": [
                                "hotels",
                                ""
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "offset",
                                    "value": "0"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "List Hotels by Province",
                    "request": {
