        {
            "name": "Hotel Deletion",
            "item": [
                {
                    "name": "Delete Single Hotel",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/hotels/hotel_paradise_view_hotel_postman",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "hotels",
                                "hotel_paradise_view_hotel_postman"
                            ]
                        },
                        "description": "Delete a specific hotel by ID"
                    }
                },
                {
                    "name": "Delete Hotels by Attraction",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/hotels/attraction/Kandy?confirm=true",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "hotels",
                                "attraction",
                                "Kandy"
                            ],
                            "query": [
                                {
                                    "key": "confirm",
                                    "value": "true"
                                }
                            ]
                        },
                        "description": "Delete all hotels for a specific attraction (requires confirmation)"
                    }
                },
                {
                    "name": "Clear All Hotels",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/hotels/clear?confirm=true",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "hotels",
                                "clear"
                            ],
                            "query": [
                                {
                                    "key": "confirm",
                                    "value": "true"
                                }
                            ]
                        },
                        "description": "⚠️ DANGER: Delete ALL hotel data (requires confirmation)"
                    }
                }
            ]
