                            ]
                        },
                        "description": "Get detailed information about a specific hotel"
                    }
                }
            ]
        },
        {
            "name": "Hotel Search & Recommendations",
            "item": [
                {
                    "name": "Advanced Search",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"location\": {\n    \"province\": \"Southern\"\n  },\n  \"filters\": {\n    \"min_rating\": 4.0,\n    \"max_price\": 200,\n    \"amenities\": [\"Wi-Fi\", \"Pool\"]\n  },\n  \"preferences\": {\n    \"sort_by\": \"rating\",\n    \"order\": \"desc\"\n  },\n  \"limit\": 10\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/hotels/search",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "hotels",
                                "search"
                            ]
                        }
                    }
                },
