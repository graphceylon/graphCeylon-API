                            "raw": "{\n  \"attractions\": [\"Galle\", \"Ella\", \"Sigiriya\"],\n  \"budget_per_night\": 20000,\n  \"preferred_amenities\": [\"Wi-Fi\", \"Pool\", \"Restaurant\"],\n  \"optimize_for\": \"balanced\",\n  \"max_results\": 5\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/hotels/recommend",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "hotels",
                                "recommend"
                            ]
                        }
                    }
