{
    "info": {
        "name": "Hotel API - GraphCeylon",
        "description": "Complete API collection for hotel management in GraphCeylon Knowledge Graph",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Hotel Ingestion",
            "item": [
                {
                    "name": "Ingest Single Hotel",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": "postman_samples/hotel_single_minimal.json"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/hotels/ingest",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "hotels",
                                "ingest"
                            ]
                        },
                        "description": "Upload a JSON file with single hotel data"
                    }
                },
                {
                    "name": "Ingest Multiple Hotels",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": "postman_samples/hotels_multiple_complete.json"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/hotels/ingest",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "hotels",
                                "ingest"
                            ]
                        },
                        "description": "Upload a JSON file with multiple hotels across different attractions"
                    }
                }
            ]
        },
        {
