@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix lk:  <http://example.org/lk#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lk:ProvinceShape a sh:NodeShape ;
  sh:targetClass lk:Province ;
  sh:property [
    sh:path lk:name ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path lk:isoCode ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path lk:hasDistrict ;
    sh:minCount 1
  ] .

lk:DistrictShape a sh:NodeShape ;
  sh:targetClass lk:District ;
  sh:property [
    sh:path lk:name ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path lk:inProvince ;
    sh:minCount 1 ; sh:maxCount 1
  ] .


# Country shape: ensure a Country has a name and an isoCode
lk:CountryShape a sh:NodeShape ;
  sh:targetClass lk:Country ;
  sh:property [
    sh:path lk:name ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path lk:isoCode ;
    sh:datatype xsd:string ;
    sh:minCount 1 ; sh:maxCount 1
  ] .