# Environment variables for Orchestrator
SERVICE_NAME=orchestrator
SERVICE_PORT=8002
LOG_LEVEL=INFO

# Service URLs
LANGUAGE_SERVICE_URL=http://localhost:8001
KG_SERVICE_URL=http://localhost:8000
